{
  "name": "projeto-300",
  "productName": "300",
  "version": "0.1.0",
  "description": "300 — assistente pessoal de inteligência artificial (voz, memória, pesquisa, controle do computador).",
  "author": "Jeferson",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "test:live": "LIVE_TESTS=1 vitest run tests/live",
    "cli": "tsx src/cli/index.ts",
    "models": "node scripts/baixar-modelos.mjs",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --dir --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@azure/msal-node": "7.1.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@mozilla/readability": "0.6.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "croner": "11.0.0",
    "docx": "9.15.1",
    "exceljs": "4.4.0",
    "linkedom": "0.18.15",
    "openai": "7.47.0",
    "pdf-lib": "1.17.1",
    "playwright-core": "1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sherpa-onnx-node": "1.12.40",
    "sqlite-vec": "0.1.9",
    "turndown": "7.2.4",
    "unpdf": "2.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
