/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Robots-Tag: noindex, nofollow
# Só as páginas e os arquivos de nome fixo são conferidos a cada abertura.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/admin.html
  Cache-Control: no-cache
/jb-nuvem.js
  Cache-Control: no-cache
/versao.json
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
# 22/11/2026 (desempenho): cada arquivo de js/ tem no nome a impressão digital do conteúdo (mudou o conteúdo, muda o nome),
# então o navegador pode guardar e nem perguntar de novo. Antes eram ~80 perguntas ao servidor a cada abertura.
/js/*
  Cache-Control: public, max-age=31536000, immutable
